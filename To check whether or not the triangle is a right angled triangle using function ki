def right_angled(a, b, c):
    if a*a + b*b == c*c:
        return True
    elif a*a + c*c == b*b:
        return True
    elif b*b + c*c == a*a:
        return True
    else:
        return False

a = int(input("Enter side 1: "))
b = int(input("Enter side 2: "))
c = int(input("Enter side 3: "))

if right_angled(a, b, c):
    print("Triangle is right angled")
else:
    print("Triangle is not right angled")
